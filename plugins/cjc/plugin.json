{
  "slug": "cjc",
  "name": "CJC - Chega Junto Concurseiro",
  "version": "1.3.0",
  "description": "Mentoria e preparação para concursos integrada ao Getfy. Reutiliza usuários, produtos, acesso, pagamentos, SMTP e tenants do core.",
  "type": "member",
  "requires": {
    "plugin_api": 2
  },
  "menu": [
    {
      "label": "CJC",
      "href": "/cjc",
      "icon": "graduation-cap"
    }
  ],
  "routes": "routes.php",
  "migrations": "migrations",
  "capabilities": [
    {
      "id": "manage",
      "label": "Gerenciar CJC"
    },
    {
      "id": "content",
      "label": "Gerenciar conteúdo CJC"
    },
    {
      "id": "students",
      "label": "Acompanhar alunos CJC"
    }
  ],
  "frontend": {
    "entry": "dist/plugin-ui.js",
    "manifest": "dist/ui.manifest.json",
    "pages": {
      "Index": "CjcIndex",
      "Student": "CjcStudent"
    },
    "exports": {
      "member_builder": {
        "cjc_exercises": "CjcCourseBuilder"
      }
    }
  },
  "member_builder_tabs": [
    {
      "id": "cjc_exercises",
      "label": "Exercícios CJC",
      "ui_export": "CjcCourseBuilder"
    }
  ],
  "render_zones": {
    "member.lesson.after_content": {
      "id": "cjc-lesson-exercises",
      "export": "CjcLessonExercises"
    }
  }
}
